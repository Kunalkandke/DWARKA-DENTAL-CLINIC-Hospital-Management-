# Frontend environment configuration
# Copy this file to .env.local and fill in your values.
# Vite exposes only variables prefixed with VITE_ to the browser.

# Backend API base URL (proxied via vite.config.js in development)
# In production, set this to your deployed API URL, e.g. https://api.dwarkadental.com
VITE_API_URL=http://localhost:5000
