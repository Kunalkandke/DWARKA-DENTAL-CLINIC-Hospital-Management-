# ─── ml-service environment variables ───────────────────────────────────────
# Copy this file to .env and fill in your values.
# A .env file is NOT loaded automatically; export these before running, or use
# a tool such as python-dotenv / direnv.

# Path to the YOLO weights file, resolved relative to app.py.
# Default: app.pt  (i.e. ml-service/app.pt)
MODEL_PATH=app.pt

# Image size used during training. Must match the --imgsz used in training.
IMGSZ=800

# Confidence threshold. Use the best threshold printed by the validation notebook.
CONF=0.276

# Version tag returned in every prediction response.
MODEL_VERSION=yolo11m-dental-v1

# Optional API key.  If set, every request except GET /health must include:
#   x-api-key: <your-secret-key>
# Leave blank (or remove) to disable authentication.
ML_API_KEY=

# Comma-separated list of allowed CORS origins.
# Example: ALLOWED_ORIGINS=https://my-clinic.com,https://www.my-clinic.com
# Leave blank to allow NO cross-origin requests (safest default).
ALLOWED_ORIGINS=
